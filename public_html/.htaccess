# OlanoandCo — configuración para Hostinger (Apache / LiteSpeed)

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

# Forzar HTTPS (se activa al tener el dominio con certificado)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Nunca servir archivos ocultos ni copias de configuración
<FilesMatch "^\.|\.(env|sqlite|sqlite-wal|sqlite-shm|log|md|example)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HTML / CSS / JS / JSON: validar en cada visita (evita versiones antiguas tras publicar)
  <FilesMatch "\.(html|css|js|json|webmanifest|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Imágenes y fuentes: caché larga
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

AddType application/manifest+json .webmanifest
AddType image/webp .webp
