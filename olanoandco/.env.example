# ============================================================
# OlanoandCo — variables de entorno (EJEMPLO, sin secretos)
# Copia este archivo como  private/.env  y rellena los valores.
# En Hostinger, la carpeta "private" va FUERA de public_html:
#   domains/TU-DOMINIO/private/.env
#   domains/TU-DOMINIO/public_html/...
# Nunca subas el .env real a Git ni lo compartas.
# ============================================================

# Clave de Google Gemini (Google AI Studio → Get API key). Vacía = el asistente
# usa respuestas de respaldo y el diagnóstico funciona sin redacción con IA.
GEMINI_API_KEY=

# Modelos a probar en orden (opcional)
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash

# Tope diario de mensajes del asistente para todo el sitio (protege la cuota)
ASSISTANT_DAILY_CAP=1000
# Límite diario de usos del simulador (Estudio OlanoandCo) con IA
ESTUDIO_DAILY_CAP=1500

# Contraseña del panel privado de prospectos (/admin). Usa una larga y única.
ADMIN_PASSWORD=

# Secreto interno para firmar tokens anti-spam (64 caracteres aleatorios).
# Si se deja vacío, se genera solo y se guarda en la carpeta de datos.
APP_SECRET=

# Aviso por correo de cada nuevo prospecto (opcional; requiere correo del dominio en Hostinger)
NOTIFY_EMAIL=
MAIL_FROM=

# Carpeta de datos privada (opcional; por defecto private/data)
DATA_DIR=
